GOOGLE_PLACES_API_KEY=
GEMINI_API_KEY=
RESEND_API_KEY=
SCOUT_EMAIL_FROM=Scout <invites@your-domain.com>
SCOUT_PUBLIC_URL=https://scoutcrm.pages.dev
GOOGLE_OAUTH_CLIENT_ID=
GEMINI_MODEL=gemini-3.1-flash-lite
FINDER_AI_MONTHLY_BUDGET_USD=2
FINDER_AI_MAX_CANDIDATES=20

# Public browser key: restrict to your site origins and Maps JavaScript + Geocoding APIs.
# Never reuse GOOGLE_PLACES_API_KEY here.
GOOGLE_MAPS_BROWSER_KEY=
GOOGLE_MAPS_MAP_ID=

# Fresh databases only: the first person allowed to become owner.
SCOUT_OWNER_EMAIL=

# Counts sent emails through a hidden BCC. Leave empty to keep this off. See "Email tracking" in the README.
EMAIL_LOG_DOMAIN=

# Where failure alerts are emailed. Needs RESEND_API_KEY and SCOUT_EMAIL_FROM.
SCOUT_ALERT_EMAIL=
